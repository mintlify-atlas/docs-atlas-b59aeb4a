  "keyFeatures": [
    "Resilient AI generation with automatic failover across multiple Gemini models",
    "Dual-engine Text-to-Speech using Microsoft Edge TTS and Google Gemini TTS",
    "Multi-platform media downloader (Instagram, Threads, YouTube, Pinterest, Twitter)",
    "AES-256 encrypted SQLite message history with configurable context pruning",
    "React-based admin WebApp dashboard with Telegram Mini App authentication",
    "Custom Persian persona presets with per-chat and per-user overrides",
    "Daily automated group chat summary scheduler",
    "Guest Bots Mode for inline usage without group membership",
    "Real-time API quota monitoring with per-model RPM/RPD meters",
    "Broadcast messaging, chat moderation, and support ticket system"
  ],
